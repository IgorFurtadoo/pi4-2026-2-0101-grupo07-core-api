# Copie para .env (que nunca vai para o git) e troque os três valores TROCAR_...
# O serviço recusa subir com qualquer um deles.

# Porta do Javalin. O compose publica 127.0.0.1:8080:8080, então mantenha 8080.
SERVER_PORT=8080

# Banco do Core API. O compose usa DB_USER e DB_PASSWORD para criar o usuário no MySQL
# na criação do volume. Mudar DB_PASSWORD depois exige recriar o volume
# (docker compose down -v, que apaga os dados) ou trocar a senha no MySQL.
DB_URL=jdbc:mysql://core-db:3306/core
DB_USER=app
DB_PASSWORD=TROCAR_senha_do_banco

# Segredo do JWT (HS256), no mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SECRET=TROCAR_gere_com_openssl_rand_-base64_48
# Validade do token, em minutos
JWT_TTL_MINUTES=240

# Chave compartilhada (P2): enviada ao Blockchain Service e exigida no webhook.
# Use o mesmo valor configurado no Blockchain Service.
SERVICE_KEY=TROCAR_mesmo_valor_do_blockchain_service

# Canal de socket do Blockchain Service (CT27): aviso de task concluída, além do webhook.
# Opcionais: sem elas, valem os padrões abaixo. TASK_SOCKET_PORT=0 desativa o canal.
# A chave da assinatura é a SERVICE_KEY acima.
# TASK_SOCKET_HOST=blockchain-service
# TASK_SOCKET_PORT=9091

# Bases dos outros módulos
BLOCKCHAIN_SERVICE_URL=http://blockchain-service:8081
EXTERNAL_DATA_SERVICE_URL=http://external-data-service:8082

# Tempo limite das chamadas aos outros módulos, em segundos
BLOCKCHAIN_TIMEOUT_SECONDS=15
EXTERNAL_DATA_TIMEOUT_SECONDS=15

# Rate limiting do CT17: requisições por janela, e tamanho da janela em segundos
MARKET_RATE_LIMIT_MAX=10
MARKET_RATE_LIMIT_WINDOW_SECONDS=60

# Origem do Frontend permitida pelo CORS (esquema://host[:porta], sem barra final)
CORS_ALLOWED_ORIGIN=http://localhost:5173
